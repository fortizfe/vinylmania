# SpecKit Companion — per-developer local run state written by the companion
# extension's capture scripts (timestamps, telemetry id, live step/status).
# The GUI reads it locally; it is not shared project state.
specs/*/.spec-context.json
specs/*/.spec-trace.jsonl

# Python bytecode cache from the SpecKit extension scripts
__pycache__/
*.pyc

# Claude Code scratch output (rendered skills, tool artifacts) — local only
Claude outputs/
